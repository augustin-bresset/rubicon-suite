# Production secrets for the docker-compose.prod.yml stack and the ops/ scripts.
# Copy to .env.prod, chmod 600, fill in real values. .env.prod is git-ignored
# and must NEVER be committed. It is also sourced by bash (ops/backup.sh,
# ops/restore.sh, ops/verify_backup.sh): keep the KEY=value form, no spaces
# around '=', quote values containing spaces or shell characters.
#
# Generate strong secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ── PostgreSQL (db service, via env_file) ──────────────────────────────────
# Must match db_user / db_password / db_name / dbfilter in odoo_conf/odoo.prod.conf.
POSTGRES_DB=rubicon
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# ── Application ────────────────────────────────────────────────────────────
# metalpriceapi.com key used by pdp_metal_market. The system parameter
# `pdp_metal_market.api_key` (Settings > Technical > System Parameters) takes
# precedence over this variable when it is set.
API_KEY_METAL_MARKET=

# ── Backups (ops/backup.sh, ops/restore.sh, ops/verify_backup.sh) ──────────
# Local backup directory (root-only; created on first run).
BACKUP_DIR=/opt/rubicon-backups

# Off-site copies are encrypted with `age` (apt install age) before leaving
# the host. One-time setup, on a trusted machine (not necessarily the server):
#   age-keygen -o rubicon-backup.key        # prints "Public key: age1..."
# Put the public key here. Store the private key file in the company password
# manager / offline: it is only needed to restore FROM the off-site copies
# (restore.sh --from-oci --identity <file>). Lose it and those copies are
# unreadable for everyone, including you.
BACKUP_AGE_RECIPIENT=

# Oracle Object Storage bucket for off-site copies (ops/setup_oci_backup.md).
# Leave empty to keep backups local only (not acceptable for production).
OCI_BUCKET=rubicon-backups
