<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Show the PDP links in the core dictionary screens -->
    <record id="view_notation_stone_list_pdp" model="ir.ui.view">
        <field name="name">gem.notation.stone.list.pdp</field>
        <field name="model">gem.notation.stone</field>
        <field name="inherit_id" ref="gem_notation.view_notation_stone_list"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="type_id"/>
            </field>
        </field>
    </record>

    <record id="view_notation_shape_list_pdp" model="ir.ui.view">
        <field name="name">gem.notation.shape.list.pdp</field>
        <field name="model">gem.notation.shape</field>
        <field name="inherit_id" ref="gem_notation.view_notation_shape_list"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="shape_id"/>
            </field>
        </field>
    </record>

    <record id="view_notation_wizard_form_pdp" model="ir.ui.view">
        <field name="name">gem.notation.wizard.form.pdp</field>
        <field name="model">gem.notation.wizard</field>
        <field name="inherit_id" ref="gem_notation.view_notation_wizard_form"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="product_id" invisible="mode != 'product'"/>
            </field>
        </field>
    </record>

    <record id="view_notation_shade_map_list" model="ir.ui.view">
        <field name="name">gem.notation.shade.map.list</field>
        <field name="model">gem.notation.shade.map</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="shade_id"/>
                <field name="grade_id"/>
                <field name="hue_id"/>
            </list>
        </field>
    </record>
    <record id="action_notation_shade_map" model="ir.actions.act_window">
        <field name="name">Shade Mappings</field>
        <field name="res_model">gem.notation.shade.map</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_notation_shade_map" name="Shade Mappings"
              parent="gem_notation.menu_notation_root"
              action="action_notation_shade_map" sequence="60"/>

    <!-- The transactional dialog: verify a written code against a real
         product. The reference workspace is the full page in the core. -->
    <record id="action_verify_product" model="ir.actions.act_window">
        <field name="name">Verify a Product</field>
        <field name="res_model">gem.notation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_mode': 'product'}</field>
    </record>
    <menuitem id="menu_verify_product" name="Verify a Product"
              parent="gem_notation.menu_notation_root"
              action="action_verify_product" sequence="15"/>
</odoo>
