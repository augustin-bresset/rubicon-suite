<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_priority_list" model="ir.actions.report">
        <field name="name">Priority List</field>
        <field name="model">pcs.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pcs_document.report_priority_list</field>
        <field name="report_file">pcs_document.report_priority_list</field>
        <field name="print_report_name">'PriorityList'</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_model_id" ref="model_pcs_document"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Replica of the legacy PCS 'Priority List' print: centered title,
         print timestamp top right, dashed row separators. -->
    <template id="report_priority_list">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <style>
                        .pcs-prio { font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #000; }
                        .pcs-prio-head { position: relative; margin-bottom: 8px; }
                        .pcs-prio-title { text-align: center; font-size: 18px; font-weight: bold; }
                        .pcs-prio-stamp { position: absolute; top: 0; right: 0; font-size: 10px; text-align: right; }
                        .pcs-prio table { width: 100%; border-collapse: collapse; }
                        .pcs-prio th { border: 1px solid #000; padding: 3px 6px; }
                        .pcs-prio td { border-bottom: 1px dashed #666; padding: 3px 6px; }
                        .pcs-prio .center { text-align: center; }
                    </style>
                    <div class="pcs-prio">
                        <div class="pcs-prio-head">
                            <div class="pcs-prio-title">Priority List</div>
                            <div class="pcs-prio-stamp"
                                 t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M:%S')"/>
                        </div>
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:8%;">No.</th>
                                    <th style="width:12%;">Priority No.</th>
                                    <th style="width:36%;">Document</th>
                                    <th style="width:22%;">Date</th>
                                    <th style="width:22%;">Del. Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="docs" t-as="doc">
                                    <td class="center" t-esc="doc_index + 1"/>
                                    <td class="center" t-esc="doc.priority_no"/>
                                    <td class="center" t-esc="doc.name"/>
                                    <td class="center"
                                        t-esc="doc.date and doc.date.strftime('%d/%m/%Y') or ''"/>
                                    <td class="center"
                                        t-esc="doc.delivery_date and doc.delivery_date.strftime('%d/%m/%Y') or ''"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
