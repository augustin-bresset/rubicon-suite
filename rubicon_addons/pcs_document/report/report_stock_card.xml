<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shared pieces: the CSS block and the body of one stock card
         (replica of the legacy SIS Report card, see
         meta/sis_report/images/sir_print.png and
         meta/documents/12_stock_card_EMA25114_r403C.pdf). -->
    <template id="stock_card_styles">
        <style>
            /* One A5-portrait card per half sheet, side by side on A4
               landscape (the sheet is cut along the dashed line). */
            .pcs-card { font-family: Arial, Helvetica, sans-serif; font-size: 9px; color: #000;
                        width: 49%; height: 196mm; float: left; padding: 2mm;
                        box-sizing: border-box; overflow: hidden; }
            .pcs-card + .pcs-card { border-left: 1px dashed #999; }
            .pcs-page { page-break-after: always; overflow: hidden; }
            .pcs-page:last-child { page-break-after: auto; }
            .pcs-card table { width: 100%; border-collapse: collapse; table-layout: fixed; }
            .pcs-card td, .pcs-card th { border: 1px solid #000; padding: 1px 3px; overflow: hidden; }
            .pcs-model { font-size: 15px; font-weight: bold; }
            .pcs-lbl { font-weight: bold; }
            .pcs-red { color: #d00000; font-weight: bold; }
            .pcs-size { font-weight: bold; text-align: right; }
            .pcs-design { font-weight: bold; font-size: 11px; }
            .pcs-qty { font-weight: bold; font-size: 12px; }
            .pcs-photo { text-align: center; vertical-align: middle; height: 30mm; }
            .pcs-photo img { max-width: 100%; max-height: 29mm; }
            .pcs-parts td { height: 12mm; vertical-align: top; }
            .pcs-part-line { font-weight: normal; }
            .pcs-part-qty { float: right; }
            .pcs-barcode-box { border: 1px solid #000; border-top: none; text-align: center;
                               padding: 2mm 0 1mm 0; }
            .pcs-barcode-box img { width: 70%; height: 11mm; }
            .pcs-barcode-text { font-family: 'Courier New', monospace; font-size: 12px;
                                letter-spacing: 2px; text-align: center; }
            .pcs-stones { margin-top: 2mm; }
            .pcs-stones th { background-color: #f0f0f0; text-align: left; }
            .pcs-stones td.num, .pcs-stones th.num { text-align: right; }
        </style>
    </template>

    <!-- Expects a `card` dict (see pcs.barcode.get_stock_card_data). -->
    <template id="stock_card_body">
        <table>
            <tr>
                <td class="pcs-model" style="width:24%;" t-esc="card['model_code']"/>
                <td colspan="2" style="width:46%; text-align:center;"
                    t-esc="card['header_center']"/>
                <td class="pcs-lbl" style="width:16%; text-align:center;">STAMP</td>
                <td style="width:14%; text-align:center;" t-esc="card['corner_ref']"/>
            </tr>
            <tr>
                <td rowspan="5" class="pcs-photo">
                    <img t-if="card['image']" t-att-src="image_data_uri(card['image'])"/>
                </td>
                <td class="pcs-lbl">ORDER#</td>
                <td>
                    <t t-esc="card['order_no']"/>
                    <div t-esc="card['so_name']"/>
                </td>
                <td class="pcs-lbl">Gold Wgt.</td>
                <td t-esc="card['gold_weight'] and round(card['gold_weight'], 2) or ''"/>
            </tr>
            <tr>
                <td class="pcs-lbl">ORDER DATE</td>
                <td t-esc="card['order_date'] and card['order_date'].strftime('%d/%m/%Y') or ''"/>
                <td class="pcs-lbl">Filing Wgt.</td>
                <td t-esc="card['filing_weight']"/>
            </tr>
            <tr>
                <td class="pcs-lbl">DELV. DATE</td>
                <td class="pcs-red" t-esc="card['delivery_date'] and card['delivery_date'].strftime('%d/%m/%Y') or ''"/>
                <td class="pcs-lbl">Filing Min.</td>
                <td t-esc="card['filing_min']"/>
            </tr>
            <tr>
                <td colspan="2" class="pcs-size">
                    <t t-if="card['size']">SIZE#<t t-esc="card['size']"/></t>
                </td>
                <td class="pcs-lbl">Setting Min</td>
                <td t-esc="card['setting_min']"/>
            </tr>
            <tr>
                <td colspan="2" class="pcs-design" t-esc="card['design']"/>
                <td class="pcs-lbl" style="text-align:center;">Gold</td>
                <td t-att-style="'text-align:center; font-weight:bold; background-color:%s;' % card['stamp_color']">
                    <t t-esc="card['metal_letter']"/> <t t-esc="card['purity']"/>
                </td>
            </tr>
            <tr>
                <td class="pcs-qty">X <t t-esc="card['qty']"/></td>
                <td colspan="4" t-esc="card['tag']"/>
            </tr>
        </table>
        <table class="pcs-parts">
            <tr>
                <td class="pcs-lbl" style="width:40%;">Part</td>
                <td class="pcs-lbl" style="width:60%;">Sub Part
                    <div t-foreach="card['parts']" t-as="part" class="pcs-part-line">
                        <t t-esc="part['code']"/>
                        <span class="pcs-part-qty" t-if="part['quantity']">
                            # <t t-esc="int(part['quantity'])"/>
                        </span>
                    </div>
                </td>
            </tr>
        </table>
        <div class="pcs-barcode-box">
            <img t-att-src="card['barcode_url']"/>
            <div class="pcs-barcode-text" t-esc="card['barcode']"/>
        </div>
        <table class="pcs-stones" t-if="card['stones']">
            <colgroup>
                <col style="width:32%;"/>
                <col style="width:10%;"/>
                <col style="width:14%;"/>
                <col style="width:16%;"/>
                <col style="width:16%;"/>
                <col style="width:12%;"/>
            </colgroup>
            <thead>
                <tr>
                    <th>Stone</th>
                    <th class="num" colspan="2">Req / Wgt</th>
                    <th>Recut</th>
                    <th class="num" colspan="2">Recut Wgt</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="card['stones']" t-as="stone">
                    <td t-esc="stone['code']"/>
                    <td class="num" t-esc="stone['pieces']"/>
                    <td class="num" t-esc="stone['weight']"/>
                    <td t-esc="stone['recut_shape']"/>
                    <td class="num" t-esc="stone['recut_size']"/>
                    <!-- second Recut Wgt column: always empty in the
                         legacy reference, kept for fidelity -->
                    <td class="num"/>
                </tr>
            </tbody>
        </table>
    </template>

    <!-- PCS side: print selected piece barcodes, two cards per sheet. -->
    <template id="report_stock_card">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-call="pcs_document.stock_card_styles"/>
                <t t-set="pairs" t-value="[docs[i:i + 2] for i in range(0, len(docs), 2)]"/>
                <t t-foreach="pairs" t-as="pair">
                    <div class="pcs-page">
                        <t t-foreach="pair" t-as="bc">
                            <t t-set="card" t-value="bc.get_stock_card_data()"/>
                            <div class="pcs-card">
                                <t t-call="pcs_document.stock_card_body"/>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- SIS side (legacy 'SIS Report'): print every card of a sales
         order, registered in production or not. -->
    <template id="report_stock_card_sis">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-call="pcs_document.stock_card_styles"/>
                <t t-foreach="docs" t-as="doc">
                    <t t-set="cards" t-value="doc._get_stock_card_datas()"/>
                    <t t-set="pairs" t-value="[cards[i:i + 2] for i in range(0, len(cards), 2)]"/>
                    <t t-foreach="pairs" t-as="pair">
                        <div class="pcs-page">
                            <t t-foreach="pair" t-as="card">
                                <div class="pcs-card">
                                    <t t-call="pcs_document.stock_card_body"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
