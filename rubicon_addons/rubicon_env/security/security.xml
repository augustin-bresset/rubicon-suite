<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ========================================================= -->
    <!--  Rubicon Suite - access levels                             -->
    <!--                                                            -->
    <!--  Every Rubicon model (PDP, SIS, PCS) has three access      -->
    <!--  levels. An internal user reads everything by default;     -->
    <!--  writing requires Editor, deleting requires Manager.       -->
    <!--  Role groups (below) imply one of the levels: assign the   -->
    <!--  role to a person, not the level.                          -->
    <!-- ========================================================= -->

    <record id="module_category_rubicon" model="ir.module.category">
        <field name="name">Rubicon</field>
        <field name="description">Access levels of the Rubicon Suite (PDP, SIS, PCS)</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_rubicon_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_rubicon"/>
        <field name="comment">Read access to every Rubicon model. Implied by "Internal User".</field>
    </record>

    <record id="group_rubicon_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="category_id" ref="module_category_rubicon"/>
        <field name="implied_ids" eval="[(4, ref('group_rubicon_user'))]"/>
        <field name="comment">Create and modify products, models, stones, documents, parties. No deletion.</field>
    </record>

    <record id="group_rubicon_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_rubicon"/>
        <field name="implied_ids" eval="[(4, ref('group_rubicon_editor'))]"/>
        <field name="comment">Editor rights plus deletion.</field>
    </record>

    <!-- Production floor: writes the PCS production records (transactions,
         SSP, clearances, barcode tags) but no master data. The models that
         accept this group are listed in pcs_document/security. -->
    <record id="group_rubicon_production" model="res.groups">
        <field name="name">Production Operator</field>
        <field name="category_id" ref="module_category_rubicon"/>
        <field name="implied_ids" eval="[(4, ref('group_rubicon_user'))]"/>
        <field name="comment">Record scans, weighings, SSP transactions and clearances on the production floor. No edition of products, prices or documents.</field>
    </record>

    <!-- Every internal user can read; administrators are managers. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_rubicon_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_rubicon_manager'))]"/>
    </record>

    <!-- ========================================================= -->
    <!--  Roles (see meta/security.md)                              -->
    <!-- ========================================================= -->

    <record id="module_category_rubicon_roles" model="ir.module.category">
        <field name="name">Rubicon roles</field>
        <field name="description">Job roles; each one implies an access level</field>
        <field name="sequence">51</field>
    </record>

    <!-- Director: full access -->
    <record id="group_rubicon_director" model="res.groups">
        <field name="name">Director</field>
        <field name="category_id" ref="module_category_rubicon_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_rubicon_manager'))]"/>
    </record>

    <!-- Manager: team leader, validation rights -->
    <record id="group_rubicon_manager_role" model="res.groups">
        <field name="name">Team Manager</field>
        <field name="category_id" ref="module_category_rubicon_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_rubicon_manager'))]"/>
    </record>

    <!-- Officer: Sales Order management, pricing, invoicing -->
    <record id="group_rubicon_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="category_id" ref="module_category_rubicon_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_rubicon_editor'))]"/>
    </record>

    <!-- Product & Model Creators -->
    <record id="group_rubicon_product_designer" model="res.groups">
        <field name="name">Product Designer</field>
        <field name="category_id" ref="module_category_rubicon_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_rubicon_editor'))]"/>
    </record>

    <!-- Stone Buyers -->
    <record id="group_rubicon_stone_buyer" model="res.groups">
        <field name="name">Stone Buyer</field>
        <field name="category_id" ref="module_category_rubicon_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_rubicon_editor'))]"/>
    </record>

    <!-- Metal Buyers -->
    <record id="group_rubicon_metal_buyer" model="res.groups">
        <field name="name">Metal Buyer</field>
        <field name="category_id" ref="module_category_rubicon_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_rubicon_editor'))]"/>
    </record>

    <!-- Stock Manager: Inventory operations -->
    <record id="group_rubicon_stock_manager" model="res.groups">
        <field name="name">Stock Manager</field>
        <field name="category_id" ref="module_category_rubicon_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_rubicon_editor'))]"/>
    </record>

    <!-- Accountant: Financial operations -->
    <record id="group_rubicon_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="category_id" ref="module_category_rubicon_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_rubicon_user'))]"/>
    </record>

    <!-- Quality Controllers -->
    <record id="group_rubicon_quality_controller" model="res.groups">
        <field name="name">Quality Controller</field>
        <field name="category_id" ref="module_category_rubicon_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_rubicon_production'))]"/>
    </record>

    <!-- Lapidary Supervisor: Production supervision -->
    <record id="group_rubicon_lapidary_supervisor" model="res.groups">
        <field name="name">Lapidary Supervisor</field>
        <field name="category_id" ref="module_category_rubicon_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_rubicon_production'))]"/>
    </record>

</odoo>
