<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_notation_stone_list" model="ir.ui.view">
        <field name="name">rubicon.notation.stone.list</field>
        <field name="model">rubicon.notation.stone</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="implied_hue_id"/>
                <field name="default_grade_id"/>
                <field name="default_hue_id"/>
                <field name="default_shape_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_notation_stone" model="ir.actions.act_window">
        <field name="name">Articles</field>
        <field name="res_model">rubicon.notation.stone</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_notation_grade_list" model="ir.ui.view">
        <field name="name">rubicon.notation.grade.list</field>
        <field name="model">rubicon.notation.grade</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_notation_grade" model="ir.actions.act_window">
        <field name="name">Grades</field>
        <field name="res_model">rubicon.notation.grade</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_notation_hue_list" model="ir.ui.view">
        <field name="name">rubicon.notation.hue.list</field>
        <field name="model">rubicon.notation.hue</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_notation_hue" model="ir.actions.act_window">
        <field name="name">Hues</field>
        <field name="res_model">rubicon.notation.hue</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_notation_shape_list" model="ir.ui.view">
        <field name="name">rubicon.notation.shape.list</field>
        <field name="model">rubicon.notation.shape</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_notation_shape" model="ir.actions.act_window">
        <field name="name">Shapes</field>
        <field name="res_model">rubicon.notation.shape</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_notation_wizard_form" model="ir.ui.view">
        <field name="name">rubicon.notation.wizard.form</field>
        <field name="model">rubicon.notation.wizard</field>
        <field name="arch" type="xml">
            <form string="Transcribe &amp; Verify">
                <group>
                    <field name="mode" widget="radio"/>
                    <field name="code"/>
                    <field name="result"/>
                </group>
                <footer>
                    <button name="action_run" string="Run" type="object"
                            class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_notation_wizard" model="ir.actions.act_window">
        <field name="name">Transcribe &amp; Verify</field>
        <field name="res_model">rubicon.notation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
