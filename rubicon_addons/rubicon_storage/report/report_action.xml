<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_stone_list" model="ir.actions.report">
        <field name="name">Stone List</field>
        <field name="model">sis.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rubicon_storage.report_stone_list</field>
        <field name="report_file">rubicon_storage.report_stone_list</field>
        <field name="print_report_name">'StoneList_' + (object.name or '').replace('/', '_')</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_model_id" ref="sis_document.model_sis_document"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
