<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rubicon_storage.RubiconStorage">
        <div class="o_action d-flex flex-column h-100">

            <!-- Toolbar -->
            <div class="d-flex align-items-center gap-2 p-2 bg-light border-bottom flex-shrink-0">
                <select class="form-select form-select-sm w-auto" t-on-change="onYearChange">
                    <t t-foreach="state.years" t-as="year" t-key="year">
                        <option t-att-value="year"
                                t-att-selected="year === state.selectedYear"
                                t-esc="year"/>
                    </t>
                </select>

                <label class="mb-0 fw-semibold">Sale Order</label>
                <select class="form-select form-select-sm" style="min-width:180px" t-on-change="onOrderChange">
                    <option value="">-- select --</option>
                    <t t-foreach="state.orders" t-as="order" t-key="order.id">
                        <option t-att-value="order.id"
                                t-att-selected="order.id === state.selectedOrderId"
                                t-esc="order.name"/>
                    </t>
                </select>

                <button class="btn btn-sm btn-primary"
                        t-att-disabled="!state.selectedOrderId"
                        t-on-click="onLoad">Load</button>

                <button class="btn btn-sm btn-secondary"
                        t-att-disabled="!state.selectedOrderId || state.rows.length === 0"
                        t-on-click="onPrint">Print</button>

                <div class="form-check mb-0 ms-2">
                    <input class="form-check-input" type="checkbox" id="rus-grouped"
                           t-att-checked="state.grouped"
                           t-on-change="onToggleGrouped"/>
                    <label class="form-check-label" for="rus-grouped">Aggregate</label>
                </div>
            </div>

            <!-- Table -->
            <div class="flex-grow-1 overflow-auto p-2">
                <table class="table table-sm table-bordered table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th t-if="!state.grouped">Product</th>
                            <th>Type</th>
                            <th>Shape</th>
                            <th>Shade</th>
                            <th>StoneSize</th>
                            <th class="text-end">Weight</th>
                            <th class="text-end">pcs</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="state.rows.length === 0">
                            <tr>
                                <td t-att-colspan="state.grouped ? 6 : 7"
                                    class="text-center text-muted fst-italic py-4">
                                    &lt;No data to display&gt;
                                </td>
                            </tr>
                        </t>
                        <t t-foreach="state.rows" t-as="row" t-key="row_index">
                            <tr>
                                <td t-if="!state.grouped" t-esc="row.product"/>
                                <td t-esc="row.type"/>
                                <td t-esc="row.shape"/>
                                <td t-esc="row.shade"/>
                                <td t-esc="row.size"/>
                                <td class="text-end" t-esc="row.weight"/>
                                <td class="text-end" t-esc="row.pcs"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Footer -->
            <div class="d-flex justify-content-end p-2 border-top bg-light flex-shrink-0">
                <button class="btn btn-sm btn-outline-secondary" t-on-click="onClose">Close</button>
            </div>

        </div>
    </t>
</templates>
